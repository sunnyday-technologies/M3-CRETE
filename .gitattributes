# Large CAD exports — stored via Git LFS so future pushes and clones
# don't have to re-transfer the full 60-70 MB step blob. See GitHub docs:
# https://docs.github.com/en/repositories/working-with-files/managing-large-files
CAD/*.step filter=lfs diff=lfs merge=lfs -text
CAD/*.STEP filter=lfs diff=lfs merge=lfs -text
CAD/*.3mf filter=lfs diff=lfs merge=lfs -text
CAD/*.3MF filter=lfs diff=lfs merge=lfs -text
CAD/*.f3d filter=lfs diff=lfs merge=lfs -text
CAD/*.F3D filter=lfs diff=lfs merge=lfs -text
# Small vendor component models (CAD/Components/, 17 KB-2.3 MB) are stored as
# ordinary blobs so github.com/.../raw/ links in bom/data.json stay plain files.
# This early project file predates the LFS rule and is also stored plainly.
CAD/ZPMM_v0.1_proj.3mf !filter !diff !merge -text
# Preserve the measured supplier STEP bytes, including its original CRLF endings.
"CAD/Advanced/Linear Rail/C-Beam 40x80x1000 Linear Rail.step" -text

# Preserve the owner-approved matching component export bytes.
CAD/Custom/Z_NEMA23_Leadscrew_Motor_Mount_Open_Access_2026-10-22_R2.step -text
CAD/Custom/Z_NEMA23_Leadscrew_Motor_Mount_Open_Access_2026-10-22_R2.stl -text
